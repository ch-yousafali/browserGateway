# Gateway auth token (optional - if set, all connections require ?token=)
# BG_TOKEN=your-secret-token

# Server port (default: 9500)
# BG_PORT=9500

# 256-bit encryption key for browser profiles (required if profiles enabled)
# Generate: openssl rand -base64 32
# BG_ENCRYPTION_KEY=

# Persistent data directory (default: /data in Docker, ~/.browser-gateway otherwise)
# BG_DATA_DIR=/data

# CloakBrowser CDP URL — used by POST/GET /v1/browser/launch to find the browser
# On Railway: https://${{cloakbrowser.RAILWAY_PUBLIC_DOMAIN}}
# BG_CLOAKBROWSER_CDP_URL=

# Provider ID that /v1/browser/launch registers (default: cloakbrowser)
# BG_LAUNCH_PROVIDER_ID=cloakbrowser

# Log level: debug | info | warn | error (overrides gateway.yml)
# LOG_LEVEL=info

# Comma-separated allowed CORS origins for the dashboard
# BG_ALLOWED_ORIGINS=https://your-frontend.example.com
