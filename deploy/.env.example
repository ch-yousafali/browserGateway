# ─────────────────────────────────────────────────────────────────────
# Railway environment variables for Browser Gateway + CloakBrowser
#
# Copy these into Railway service variables (Settings > Variables).
# Generate secrets with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════════
# GATEWAY SERVICE
# ════════════════════════════════════════════════════════════════════

# Auth token for API, dashboard, and MCP endpoints.
# Required — without it the gateway is open to anyone.
# Generate: openssl rand -base64 32
BG_TOKEN=

# 256-bit encryption key for browser profiles (cookies, localStorage).
# Required if profiles are enabled (they are in the Railway config).
# Do NOT lose this — all saved profiles become unreadable without it.
# Generate: openssl rand -base64 32
BG_ENCRYPTION_KEY=

# Persistent data directory. Must match the volume mount path on Railway.
BG_DATA_DIR=/data

# CloakBrowser CDP URL. On Railway, use cross-service interpolation:
#   BG_CLOAKBROWSER_CDP_URL=https://${{cloakbrowser.RAILWAY_PUBLIC_DOMAIN}}
# If your CLI doesn't expand that, set it to the cloakbrowser's public domain:
#   BG_CLOAKBROWSER_CDP_URL=https://cloakbrowser-xxx.up.railway.app
BG_CLOAKBROWSER_CDP_URL=

# Provider ID that /v1/browser/launch registers the CloakBrowser as.
BG_LAUNCH_PROVIDER_ID=cloakbrowser

# Optional — log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Optional — comma-separated list of allowed CORS origins for the dashboard
# BG_ALLOWED_ORIGINS=https://your-frontend.example.com

# ════════════════════════════════════════════════════════════════════
# CLOAKBROWSER SERVICE
# ════════════════════════════════════════════════════════════════════

# Railway injects PORT automatically — no need to set it.
# The entrypoint defaults to 9223 if PORT is not set.

# Home directory for the browser process.
HOME=/home/clawbrowser
